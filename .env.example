# ==============================================================================
# CONTAINER TRUCK QUEUE MANAGEMENT SYSTEM (PORT GATE TOS)
# Environment Configuration Template
# ==============================================================================

# Django Core
SECRET_KEY=django-insecure-portgate-tos-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONFIGURATION
# ------------------------------------------------------------------------------
# Masukkan connection string PostgreSQL dari dashboard Supabase Anda:
# Project Settings -> Database -> Connection string -> URI
#
# Opsi 1: Connection Pooling (Port 6543 / Session or Transaction mode) - Direkomendasikan
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Opsi 2: Direct Connection (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Catatan: Jika DATABASE_URL dikosongkan, sistem akan otomatis menggunakan
# fallback SQLite lokal agar Django tetap bisa dijalankan untuk pengujian awal.
DATABASE_URL=
